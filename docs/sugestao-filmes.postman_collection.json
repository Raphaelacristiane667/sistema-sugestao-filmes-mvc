{
  "info": {
    "name": "Sugestão de Filmes - API T2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD de filmes, categorias e avaliações + sugestões por categoria. Ajuste a variável baseUrl se precisar."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/mvc/api"
    }
  ],
  "item": [
    {
      "name": "Filmes",
      "item": [
        {
          "name": "Listar filmes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/filmes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "filmes"
              ]
            }
          }
        },
        {
          "name": "Buscar filme",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/filmes/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "filmes",
                "1"
              ]
            }
          }
        },
        {
          "name": "Criar filme",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/filmes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "filmes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Duna\",\n  \"anoLancamento\": 2021\n}"
            }
          }
        },
        {
          "name": "Atualizar filme",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/filmes/6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "filmes",
                "6"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Duna: Parte Um\",\n  \"anoLancamento\": 2021\n}"
            }
          }
        },
        {
          "name": "Excluir filme",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/filmes/6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "filmes",
                "6"
              ]
