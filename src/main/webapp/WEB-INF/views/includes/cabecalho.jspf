<%@ page pageEncoding="UTF-8" %>
<a class="pular" href="#conteudo">Ir para o conteúdo</a>
<header class="topo">
  <div class="topo-linha">
    <a class="marca" href="${pageContext.request.contextPath}/">Sugestão de Filmes</a>
    <nav class="nav" aria-label="Principal">
      <a class="${pageContext.request.servletPath == '/index.jsp' || pageContext.request.servletPath == '/' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/">Início</a>
      <a class="${pageContext.request.servletPath == '/filmes' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/filmes">Filmes</a>
      <a class="${pageContext.request.servletPath == '/categorias' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/categorias">Categorias</a>
      <a class="${pageContext.request.servletPath == '/avaliacoes' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/avaliacoes">Avaliações</a>
    </nav>
  </div>
</header>
