<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a class="pular" href="#conteudo">Ir para o conteúdo</a>
<header class="topo">
  <div class="topo-linha">
    <a class="marca" href="${pageContext.request.contextPath}/">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M2 10h20M7 6l3 4M12 6l3 4M17 6l3 4M4 2.5l16 3.5"/></svg>
      CineSugere
    </a>
    <%-- Depois do forward do servlet, o caminho original fica neste atributo --%>
    <c:set var="rota" value="${empty requestScope['jakarta.servlet.forward.servlet_path'] ? pageContext.request.servletPath : requestScope['jakarta.servlet.forward.servlet_path']}"/>
    <nav class="nav" aria-label="Principal">
      <a class="${rota == '/index.jsp' || rota == '/' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/">Início</a>
      <a class="${rota == '/filmes' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/filmes">Filmes</a>
      <a class="${rota == '/categorias' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/categorias">Categorias</a>
      <a class="${rota == '/avaliacoes' ? 'is-on' : ''}" href="${pageContext.request.contextPath}/avaliacoes">Avaliações</a>
      <a href="${applicationScope.apiUrl}/docs/">API</a>
    </nav>
  </div>
</header>
